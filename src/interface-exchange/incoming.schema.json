{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/IncomingInterfaceMessage",
  "definitions": {
    "IncomingInterfaceMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/SignalMessage"
        },
        {
          "$ref": "#/definitions/UserCommandMessage"
        },
        {
          "$ref": "#/definitions/UserFocusMessage"
        },
        {
          "$ref": "#/definitions/UserInputMessage"
        }
      ],
      "description": "Union of every message type."
    },
    "SignalMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "signal"
        },
        "code": {
          "type": "number"
        },
        "element": {
          "anyOf": [
            {
              "$ref": "#/definitions/Prompt"
            },
            {
              "$ref": "#/definitions/Cell"
            }
          ]
        }
      },
      "required": [
        "type",
        "code",
        "element"
      ],
      "additionalProperties": false
    },
    "Prompt": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "The prompt/tab label."
        },
        "bindings": {
          "$ref": "#/definitions/PromptBindings",
          "description": "Key-chord → action-name map for this prompt."
        },
        "color": {
          "$ref": "#/definitions/PromptColor",
          "description": "Accent color for the prompt."
        },
        "prompt_html": {
          "type": "string",
          "description": "HTML for the prompt's leading label/marker."
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Text in the prompt."
        },
        "ranges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HighlightRange"
          },
          "description": "Spans to colorize."
        },
        "_id": {
          "type": "number"
        },
        "zone": {
          "$ref": "#/definitions/Zone"
        },
        "address": {
          "$ref": "#/definitions/Address"
        }
      },
      "required": [
        "_id",
        "address",
        "zone"
      ],
      "additionalProperties": false
    },
    "PromptBindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "PromptColor": {
      "type": "object",
      "properties": {
        "hue": {
          "type": "number",
          "description": "OKLCH hue"
        },
        "chroma": {
          "type": "number",
          "description": "OKLCH chroma"
        }
      },
      "additionalProperties": false
    },
    "HighlightRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "description": "Inclusive start offset into the prompt text."
        },
        "end": {
          "type": "number",
          "description": "Exclusive end offset."
        },
        "cls": {
          "type": "string",
          "description": "CSS class."
        }
      },
      "required": [
        "start",
        "end",
        "cls"
      ],
      "additionalProperties": false,
      "description": "A syntax-highlight span over the prompt text"
    },
    "Zone": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "number"
        },
        "parent": {
          "$ref": "#/definitions/Zone"
        }
      },
      "additionalProperties": false,
      "required": [
        "_id"
      ]
    },
    "Address": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Cell": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "The cell/tab label."
        },
        "sticky": {
          "type": "boolean",
          "description": "Toggle whether the cell keeps or relinquishes focus when it is closed."
        },
        "background": {
          "type": "boolean",
          "description": "If true, do not automatically focus the cell."
        },
        "_id": {
          "type": "number"
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/definitions/Prompt"
            },
            {
              "type": "null"
            }
          ]
        },
        "zone": {
          "$ref": "#/definitions/Zone"
        },
        "address": {
          "$ref": "#/definitions/Address"
        }
      },
      "required": [
        "_id",
        "address",
        "prompt",
        "zone"
      ],
      "additionalProperties": false
    },
    "UserCommandMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "user_command"
        },
        "prompt": {
          "$ref": "#/definitions/Prompt"
        },
        "text": {
          "type": "string"
        },
        "position": {
          "type": "number"
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "prompt",
        "text",
        "position",
        "command"
      ],
      "additionalProperties": false
    },
    "UserFocusMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "user_focus"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "UserInputMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "user_input"
        },
        "prompt": {
          "$ref": "#/definitions/Prompt"
        },
        "text": {
          "type": "string"
        },
        "position": {
          "type": "number"
        }
      },
      "required": [
        "type",
        "prompt",
        "text",
        "position"
      ],
      "additionalProperties": false
    }
  }
}
