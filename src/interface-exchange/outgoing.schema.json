{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/OutgoingInterfaceMessage",
  "definitions": {
    "OutgoingInterfaceMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/InstallEchoMessage"
        },
        {
          "$ref": "#/definitions/InstallCellMessage"
        },
        {
          "$ref": "#/definitions/InstallPromptMessage"
        },
        {
          "$ref": "#/definitions/CloseComponentMessage"
        },
        {
          "$ref": "#/definitions/CellCommandMessage"
        },
        {
          "$ref": "#/definitions/PromptSubmitMessage"
        }
      ],
      "description": "Union of every message type."
    },
    "InstallEchoMessage": {
      "type": "object",
      "properties": {
        "zone": {
          "$ref": "#/definitions/Zone"
        },
        "component": {
          "$ref": "#/definitions/ComponentData"
        },
        "type": {
          "type": "string",
          "const": "install_echo"
        }
      },
      "required": ["component", "type", "zone"],
      "additionalProperties": false
    },
    "Zone": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "number"
        }
      },
      "required": ["_id"]
    },
    "ComponentData": {
      "type": "object",
      "properties": {
        "echo": {
          "$ref": "#/definitions/Echo"
        },
        "cell": {
          "$ref": "#/definitions/Cell"
        },
        "prompt": {
          "$ref": "#/definitions/Prompt"
        },
        "zones": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/Zone"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["zones"],
      "additionalProperties": false
    },
    "Echo": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "number"
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/definitions/Prompt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": ["_id", "prompt"],
      "additionalProperties": false
    },
    "Prompt": {
      "type": "object",
      "properties": {
        "label": {
          "type": ["string", "null"],
          "description": "The prompt/tab label."
        },
        "bindings": {
          "$ref": "#/definitions/PromptBindings",
          "description": "Key-chord → action-name map for this prompt."
        },
        "color": {
          "$ref": "#/definitions/PromptColor",
          "description": "Accent color for the prompt."
        },
        "prompt_html": {
          "type": "string",
          "description": "HTML for the prompt's leading label/marker."
        },
        "_id": {
          "type": "number"
        },
        "zone": {
          "$ref": "#/definitions/Zone"
        },
        "address": {
          "$ref": "#/definitions/Address"
        }
      },
      "required": ["_id", "address", "zone"],
      "additionalProperties": false
    },
    "PromptBindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "PromptColor": {
      "type": "object",
      "properties": {
        "hue": {
          "type": "number",
          "description": "OKLCH hue"
        },
        "chroma": {
          "type": "number",
          "description": "OKLCH chroma"
        }
      },
      "additionalProperties": false
    },
    "Address": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Cell": {
      "type": "object",
      "properties": {
        "label": {
          "type": ["string", "null"],
          "description": "The cell/tab label."
        },
        "sticky": {
          "type": "boolean",
          "description": "Toggle whether the cell keeps or relinquishes focus when it is closed."
        },
        "background": {
          "type": "boolean",
          "description": "If true, do not automatically focus the cell."
        },
        "_id": {
          "type": "number"
        },
        "prompt": {
          "anyOf": [
            {
              "$ref": "#/definitions/Prompt"
            },
            {
              "type": "null"
            }
          ]
        },
        "zone": {
          "$ref": "#/definitions/Zone"
        },
        "address": {
          "$ref": "#/definitions/Address"
        }
      },
      "required": ["_id", "address", "prompt", "zone"],
      "additionalProperties": false
    },
    "InstallCellMessage": {
      "type": "object",
      "properties": {
        "zone": {
          "$ref": "#/definitions/Zone"
        },
        "component": {
          "$ref": "#/definitions/ComponentData"
        },
        "type": {
          "type": "string",
          "const": "install_cell"
        }
      },
      "required": ["component", "type", "zone"],
      "additionalProperties": false
    },
    "InstallPromptMessage": {
      "type": "object",
      "properties": {
        "zone": {
          "$ref": "#/definitions/Zone"
        },
        "component": {
          "$ref": "#/definitions/ComponentData"
        },
        "type": {
          "type": "string",
          "const": "install_prompt"
        }
      },
      "required": ["component", "type", "zone"],
      "additionalProperties": false
    },
    "CloseComponentMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "close_component"
        },
        "component": {
          "$ref": "#/definitions/ComponentData"
        }
      },
      "required": ["type", "component"],
      "additionalProperties": false
    },
    "CellCommandMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "cell_command"
        },
        "command": {
          "$ref": "#/definitions/CellCommand"
        },
        "component": {
          "$ref": "#/definitions/ComponentData"
        }
      },
      "required": ["type", "command", "component"],
      "additionalProperties": false
    },
    "CellCommand": {
      "anyOf": [
        {
          "$ref": "#/definitions/TextCommand"
        },
        {
          "$ref": "#/definitions/DataCommand"
        },
        {
          "$ref": "#/definitions/ExecCommand"
        }
      ]
    },
    "TextCommand": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "stream": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["type", "stream", "text"],
      "additionalProperties": false
    },
    "DataCommand": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "data"
        },
        "data": {
          "$ref": "#/definitions/Json"
        }
      },
      "required": ["type", "data"],
      "additionalProperties": false
    },
    "Json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Json"
          }
        }
      ],
      "description": "Any JSON-serializable value (payloads exchanged over the FDs)."
    },
    "ExecCommand": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "exec"
        },
        "code": {
          "type": "string"
        }
      },
      "required": ["type", "code"],
      "additionalProperties": false
    },
    "PromptSubmitMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "prompt_submit"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    }
  }
}
