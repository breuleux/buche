{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/IncomingDriverMessage",
  "definitions": {
    "IncomingDriverMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/CellConfigureMessage"
        },
        {
          "$ref": "#/definitions/CellSendMessage"
        },
        {
          "$ref": "#/definitions/CloseMessage"
        },
        {
          "$ref": "#/definitions/DataMessage"
        },
        {
          "$ref": "#/definitions/EchoMessage"
        },
        {
          "$ref": "#/definitions/ErrorMessage"
        },
        {
          "$ref": "#/definitions/PromptConfigureMessage"
        },
        {
          "$ref": "#/definitions/SyncMessage"
        },
        {
          "$ref": "#/definitions/TextMessage"
        }
      ],
      "description": "Union of every message type."
    },
    "CellConfigureMessage": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "The cell/tab label."
        },
        "sticky": {
          "type": "boolean",
          "description": "Toggle whether the cell keeps or relinquishes focus when it is closed."
        },
        "background": {
          "type": "boolean",
          "description": "If true, do not automatically focus the cell."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "zone": {
          "anyOf": [
            {
              "$ref": "#/definitions/ZoneDescriptor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which zone to put the element in."
        },
        "type": {
          "type": "string",
          "const": "cell_configure",
          "description": "Type of the message."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        }
      },
      "required": [
        "from",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "Address": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ZoneDescriptor": {
      "type": "string"
    },
    "To": {
      "$ref": "#/definitions/Address"
    },
    "CellSendMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "cell_send",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "message": {
          "$ref": "#/definitions/CellCommand",
          "description": "Message to send to the cell."
        }
      },
      "required": [
        "from",
        "message",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "CellCommand": {
      "anyOf": [
        {
          "$ref": "#/definitions/TextCommand"
        },
        {
          "$ref": "#/definitions/DataCommand"
        },
        {
          "$ref": "#/definitions/ExecCommand"
        },
        {
          "$ref": "#/definitions/ErrorCommand"
        }
      ]
    },
    "TextCommand": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "stream": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "stream",
        "text"
      ],
      "additionalProperties": false
    },
    "DataCommand": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "data"
        },
        "data": {
          "$ref": "#/definitions/Json"
        }
      },
      "required": [
        "type",
        "data"
      ],
      "additionalProperties": false
    },
    "Json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Json"
          }
        }
      ],
      "description": "Any JSON-serializable value (payloads exchanged over the FDs)."
    },
    "ExecCommand": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "exec"
        },
        "code": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "code"
      ],
      "additionalProperties": false
    },
    "ErrorCommand": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error"
        },
        "error_type": {
          "type": "string",
          "description": "Class/kind of the error, e.g. the exception type."
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message."
        },
        "traceback": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Traceback lines, when available."
        }
      },
      "required": [
        "type",
        "error_type",
        "message",
        "traceback"
      ],
      "additionalProperties": false
    },
    "CloseMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "close",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "outcome": {
          "$ref": "#/definitions/CloseOutcome",
          "description": "How the process terminated."
        }
      },
      "required": [
        "from",
        "outcome",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "CloseOutcome": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "success",
            "error"
          ],
          "description": "Whether the process ended successfully or with an error."
        },
        "code": {
          "type": "number",
          "description": "Exit/return code, when available."
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "Outcome of a process that has terminated."
    },
    "DataMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "data",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "data": {
          "$ref": "#/definitions/Json",
          "description": "The data."
        }
      },
      "required": [
        "data",
        "from",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "EchoMessage": {
      "type": "object",
      "properties": {
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Text of the command."
        },
        "ranges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HighlightRange"
          },
          "description": "Spans to colorize."
        },
        "type": {
          "type": "string",
          "const": "echo",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        }
      },
      "required": [
        "from",
        "ranges",
        "text",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "HighlightRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "description": "Inclusive start offset into the prompt text."
        },
        "end": {
          "type": "number",
          "description": "Exclusive end offset."
        },
        "cls": {
          "type": "string",
          "description": "CSS class."
        }
      },
      "required": [
        "start",
        "end",
        "cls"
      ],
      "additionalProperties": false,
      "description": "A syntax-highlight span over the prompt text"
    },
    "ErrorMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "error_type": {
          "type": "string",
          "description": "Class/kind of the error, e.g. the exception type."
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message."
        },
        "traceback": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Traceback lines, when available."
        }
      },
      "required": [
        "error_type",
        "from",
        "message",
        "to",
        "type"
      ],
      "additionalProperties": false,
      "description": "An error reported by the process (as opposed to a Buche-side `buche_error`)."
    },
    "PromptConfigureMessage": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "The prompt/tab label."
        },
        "bindings": {
          "$ref": "#/definitions/PromptBindings",
          "description": "Key-chord → action-name map for this prompt."
        },
        "color": {
          "$ref": "#/definitions/PromptColor",
          "description": "Accent color for the prompt."
        },
        "prompt_html": {
          "type": "string",
          "description": "HTML for the prompt's leading label/marker."
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Text in the prompt."
        },
        "ranges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HighlightRange"
          },
          "description": "Spans to colorize."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "zone": {
          "anyOf": [
            {
              "$ref": "#/definitions/ZoneDescriptor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which zone to put the element in."
        },
        "type": {
          "type": "string",
          "const": "prompt_configure",
          "description": "Type of the message."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        }
      },
      "required": [
        "from",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "PromptBindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "PromptColor": {
      "type": "object",
      "properties": {
        "hue": {
          "type": "number",
          "description": "OKLCH hue"
        },
        "chroma": {
          "type": "number",
          "description": "OKLCH chroma"
        }
      },
      "additionalProperties": false
    },
    "SyncMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sync",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "nonce": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "nonce",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "TextMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "stream": {
          "type": "string",
          "enum": [
            "stdout",
            "stderr"
          ],
          "description": "Stream on which the message was sent."
        },
        "text": {
          "type": "string",
          "description": "Text that was sent."
        }
      },
      "required": [
        "from",
        "stream",
        "text",
        "to",
        "type"
      ],
      "additionalProperties": false
    }
  }
}
