{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/IncomingDriverMessage",
  "definitions": {
    "IncomingDriverMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/CellConfigureMessage"
        },
        {
          "$ref": "#/definitions/CellCreateMessage"
        },
        {
          "$ref": "#/definitions/EchoMessage"
        },
        {
          "$ref": "#/definitions/PromptConfigureMessage"
        },
        {
          "$ref": "#/definitions/PromptCreateMessage"
        },
        {
          "$ref": "#/definitions/SyncMessage"
        }
      ],
      "description": "Union of every message type."
    },
    "CellConfigureMessage": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "The cell/tab label."
        },
        "sticky": {
          "type": "boolean",
          "description": "Toggle whether the cell persists after its process closes."
        },
        "background": {
          "type": "boolean",
          "description": "If true, unfocus the cell and return focus to its zone."
        },
        "type": {
          "type": "string",
          "const": "cell_configure",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        }
      },
      "required": [
        "from",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "Address": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "To": {
      "$ref": "#/definitions/Address"
    },
    "CellCreateMessage": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "The cell/tab label."
        },
        "sticky": {
          "type": "boolean",
          "description": "Toggle whether the cell persists after its process closes."
        },
        "background": {
          "type": "boolean",
          "description": "If true, unfocus the cell and return focus to its zone."
        },
        "type": {
          "type": "string",
          "const": "cell_create",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "mode": {
          "type": "string",
          "description": "Which cell handler to instantiate. Unknown modes are ignored with an error."
        },
        "prompt_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Associates the cell with an existing prompt."
        },
        "zone": {
          "anyOf": [
            {
              "$ref": "#/definitions/ZoneDescriptor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which zone to put the cell in."
        }
      },
      "required": [
        "from",
        "mode",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "ZoneDescriptor": {
      "type": "string"
    },
    "EchoMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "echo",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "prompt_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Associates the echo with an existing prompt."
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Text of the command."
        },
        "ranges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HighlightRange"
          },
          "description": "Spans to colorize."
        }
      },
      "required": [
        "from",
        "prompt_id",
        "ranges",
        "text",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "HighlightRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "description": "Inclusive start offset into the prompt text."
        },
        "end": {
          "type": "number",
          "description": "Exclusive end offset."
        },
        "cls": {
          "type": "string",
          "description": "CSS class."
        }
      },
      "required": [
        "start",
        "end",
        "cls"
      ],
      "additionalProperties": false,
      "description": "A syntax-highlight span over the prompt text"
    },
    "PromptConfigureMessage": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "The prompt/tab label."
        },
        "bindings": {
          "$ref": "#/definitions/PromptBindings",
          "description": "Key-chord → action-name map for this prompt."
        },
        "color": {
          "$ref": "#/definitions/PromptColor",
          "description": "Accent color for the prompt."
        },
        "prompt_html": {
          "type": "string",
          "description": "HTML for the prompt's leading label/marker."
        },
        "type": {
          "type": "string",
          "const": "prompt_configure",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        }
      },
      "required": [
        "from",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "PromptBindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Prompt key bindings, as a `{ \"keyChord\": actionName }` map (e.g. `{ \"Tab Tab\": \"complete\" }`). The prompt turns this into `{key, name}` entries."
    },
    "PromptColor": {
      "type": "object",
      "properties": {
        "hue": {
          "type": "number",
          "description": "OKLCH hue"
        },
        "chroma": {
          "type": "number",
          "description": "OKLCH chroma"
        }
      },
      "additionalProperties": false,
      "description": "Prompt accent color, expressed in the OKLCH color space."
    },
    "PromptCreateMessage": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "The prompt/tab label."
        },
        "bindings": {
          "$ref": "#/definitions/PromptBindings",
          "description": "Key-chord → action-name map for this prompt."
        },
        "color": {
          "$ref": "#/definitions/PromptColor",
          "description": "Accent color for the prompt."
        },
        "prompt_html": {
          "type": "string",
          "description": "HTML for the prompt's leading label/marker."
        },
        "type": {
          "type": "string",
          "const": "prompt_create",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "prompt_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Associates the prompt with another existing prompt."
        },
        "zone": {
          "anyOf": [
            {
              "$ref": "#/definitions/ZoneDescriptor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which zone to put the prompt in."
        }
      },
      "required": [
        "from",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "SyncMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sync",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "nonce": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "nonce",
        "to",
        "type"
      ],
      "additionalProperties": false
    }
  }
}
