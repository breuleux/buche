{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/IncomingDriverMessage",
  "definitions": {
    "IncomingDriverMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/CellConfigureMessage"
        },
        {
          "$ref": "#/definitions/CellSendMessage"
        },
        {
          "$ref": "#/definitions/CloseMessage"
        },
        {
          "$ref": "#/definitions/ConfigureMessage"
        },
        {
          "$ref": "#/definitions/DataMessage"
        },
        {
          "$ref": "#/definitions/ErrorMessage"
        },
        {
          "$ref": "#/definitions/PromptConfigureMessage"
        },
        {
          "$ref": "#/definitions/PromptHighlightMessage"
        },
        {
          "$ref": "#/definitions/SyncMessage"
        },
        {
          "$ref": "#/definitions/TextMessage"
        }
      ],
      "description": "Union of every message type."
    },
    "CellConfigureMessage": {
      "type": "object",
      "properties": {
        "submission": {
          "$ref": "#/definitions/SubmissionConfiguration",
          "description": "What was submitted: the command text, and the context it was submitted in (e.g. the prompt it was typed at: host, path, branch). The context, when present, is shown above the echo box in the accent color. A configuration may give either subfield alone; the other keeps its current value."
        },
        "label": {
          "type": "string",
          "description": "The cell/tab label."
        },
        "color": {
          "$ref": "#/definitions/Accent",
          "description": "Accent color for the component."
        },
        "id": {
          "type": "string",
          "description": "The id of the user command this echo answers (repeated from the \"command\" request's `id`). The interface uses it to give the focus to the echo's element when it appears."
        },
        "sticky": {
          "type": "boolean",
          "description": "If true, keep the focus on the cell when its process ends."
        },
        "background": {
          "type": "boolean",
          "description": "If true, do not automatically focus the cell or prompt."
        },
        "ephemeral": {
          "type": "boolean",
          "description": "If true, the element showing this entry (the cell's box, and with it its tab) is removed when the entry is marked done or error. Prompts already go away when their process ends."
        },
        "represents": {
          "anyOf": [
            {
              "$ref": "#/definitions/Address"
            },
            {
              "type": "null"
            }
          ],
          "description": "Address of the entry this one stands for (typically the process that owns it). While set, the entry's status mirrors that entry's, and user signals, input and resizes are routed to its address. Explicit null disables the mirroring."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "zone": {
          "anyOf": [
            {
              "$ref": "#/definitions/ZoneDescriptor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which zone to put the element in."
        },
        "type": {
          "type": "string",
          "const": "cell_configure",
          "description": "Type of the message."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        }
      },
      "required": [
        "from",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "SubmissionConfiguration": {
      "type": "object",
      "properties": {
        "content": {
          "$ref": "#/definitions/StyledText",
          "description": "Content text of the submission"
        },
        "context": {
          "$ref": "#/definitions/StyledText",
          "description": "Context of the submission (prompt text)"
        }
      },
      "additionalProperties": false
    },
    "StyledText": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "Text to style."
        },
        "ranges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HighlightRange"
          },
          "description": "Spans to colorize."
        },
        "position": {
          "type": [
            "number",
            "null"
          ],
          "description": "Position of the cursor, if applicable."
        }
      },
      "required": [
        "text",
        "ranges"
      ],
      "additionalProperties": false
    },
    "HighlightRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": [
            "number",
            "null"
          ],
          "description": "Inclusive start offset. `null` means the start of the text (offset 0); in an editable prompt it is an *open* boundary that also absorbs text the user inserts at the very beginning."
        },
        "end": {
          "type": [
            "number",
            "null"
          ],
          "description": "Exclusive end offset. `null` means the end of the text; in an editable prompt it is an *open* boundary that also absorbs text the user appends."
        },
        "style": {
          "$ref": "#/definitions/Accent",
          "description": "Style."
        }
      },
      "required": [
        "start",
        "end",
        "style"
      ],
      "additionalProperties": false,
      "description": "A syntax-highlight span over the prompt text"
    },
    "Accent": {
      "type": "string"
    },
    "Address": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ZoneDescriptor": {
      "type": "string"
    },
    "To": {
      "$ref": "#/definitions/Address"
    },
    "CellSendMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "cell_send",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "message": {
          "$ref": "#/definitions/CellCommand",
          "description": "Message to send to the cell."
        }
      },
      "required": [
        "from",
        "message",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "CellCommand": {
      "anyOf": [
        {
          "$ref": "#/definitions/TextCommand"
        },
        {
          "$ref": "#/definitions/DataCommand"
        },
        {
          "$ref": "#/definitions/ExecCommand"
        }
      ]
    },
    "TextCommand": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "stream": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "stream",
        "text"
      ],
      "additionalProperties": false
    },
    "DataCommand": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "data"
        },
        "data": {
          "$ref": "#/definitions/Json"
        }
      },
      "required": [
        "type",
        "data"
      ],
      "additionalProperties": false
    },
    "Json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Json"
          }
        }
      ]
    },
    "ExecCommand": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "exec"
        },
        "code": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "code"
      ],
      "additionalProperties": false
    },
    "CloseMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "close",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "outcome": {
          "$ref": "#/definitions/CloseOutcome",
          "description": "How the process terminated."
        }
      },
      "required": [
        "from",
        "outcome",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "CloseOutcome": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "success",
            "error"
          ],
          "description": "Whether the process ended successfully or with an error."
        },
        "code": {
          "type": "number",
          "description": "Exit/return code, when available."
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "Outcome of a process that has terminated."
    },
    "ConfigureMessage": {
      "type": "object",
      "properties": {
        "submission": {
          "$ref": "#/definitions/SubmissionConfiguration",
          "description": "What was submitted: the command text, and the context it was submitted in (e.g. the prompt it was typed at: host, path, branch). The context, when present, is shown above the echo box in the accent color. A configuration may give either subfield alone; the other keeps its current value."
        },
        "label": {
          "type": "string",
          "description": "The cell/tab label."
        },
        "color": {
          "$ref": "#/definitions/Accent",
          "description": "Accent color for the component."
        },
        "id": {
          "type": "string",
          "description": "The id of the user command this echo answers (repeated from the \"command\" request's `id`). The interface uses it to give the focus to the echo's element when it appears."
        },
        "sticky": {
          "type": "boolean",
          "description": "If true, keep the focus on the cell when its process ends."
        },
        "background": {
          "type": "boolean",
          "description": "If true, do not automatically focus the cell or prompt."
        },
        "ephemeral": {
          "type": "boolean",
          "description": "If true, the element showing this entry (the cell's box, and with it its tab) is removed when the entry is marked done or error. Prompts already go away when their process ends."
        },
        "represents": {
          "anyOf": [
            {
              "$ref": "#/definitions/Address"
            },
            {
              "type": "null"
            }
          ],
          "description": "Address of the entry this one stands for (typically the process that owns it). While set, the entry's status mirrors that entry's, and user signals, input and resizes are routed to its address. Explicit null disables the mirroring."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "zone": {
          "anyOf": [
            {
              "$ref": "#/definitions/ZoneDescriptor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which zone to put the element in."
        },
        "type": {
          "type": "string",
          "const": "configure",
          "description": "Type of the message."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        }
      },
      "required": [
        "from",
        "to",
        "type"
      ],
      "additionalProperties": false,
      "description": "Declares (or reconfigures) an entry without installing anything in any zone: a process, or any non-visual parent of cells and prompts. It carries the shared echo configuration (label, color, `represents`, `ephemeral`, ...) — applied without creating a cell, so it can retune an entry that already has one, or state things about one that doesn't — and records its placement: descendants resolve their zones through this entry (an unnamed request gets the configured zone, recorded under `\"\"`; a named one matches the configured zone's own names; `origin` names the zone an unnamed request would have resolved to anyway, typically the spawning prompt)."
    },
    "DataMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "data",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "data": {
          "$ref": "#/definitions/Json",
          "description": "The data."
        }
      },
      "required": [
        "data",
        "from",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "ErrorMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "error",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "error_type": {
          "type": "string",
          "description": "Class/kind of the error, e.g. the exception type."
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message."
        },
        "traceback": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Traceback lines, when available."
        }
      },
      "required": [
        "error_type",
        "from",
        "message",
        "to",
        "type"
      ],
      "additionalProperties": false,
      "description": "An error reported by the process"
    },
    "PromptConfigureMessage": {
      "type": "object",
      "properties": {
        "bindings": {
          "$ref": "#/definitions/PromptBindings",
          "description": "Key-chord → action-name map for this prompt."
        },
        "submission": {
          "$ref": "#/definitions/SubmissionConfiguration",
          "description": "What was submitted: the command text, and the context it was submitted in (e.g. the prompt it was typed at: host, path, branch). The context, when present, is shown above the echo box in the accent color. A configuration may give either subfield alone; the other keeps its current value."
        },
        "filigrane": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ghost text (history suggestion), normally carried by \"prompt_highlight\"; a \"prompt_configure\" may set or clear it too (explicit null) — e.g. to drop the suggestion along with the text when the prompt is submitted. Absent: left as is."
        },
        "label": {
          "type": "string",
          "description": "The cell/tab label."
        },
        "color": {
          "$ref": "#/definitions/Accent",
          "description": "Accent color for the component."
        },
        "id": {
          "type": "string",
          "description": "The id of the user command this echo answers (repeated from the \"command\" request's `id`). The interface uses it to give the focus to the echo's element when it appears."
        },
        "sticky": {
          "type": "boolean",
          "description": "If true, keep the focus on the cell when its process ends."
        },
        "background": {
          "type": "boolean",
          "description": "If true, do not automatically focus the cell or prompt."
        },
        "ephemeral": {
          "type": "boolean",
          "description": "If true, the element showing this entry (the cell's box, and with it its tab) is removed when the entry is marked done or error. Prompts already go away when their process ends."
        },
        "represents": {
          "anyOf": [
            {
              "$ref": "#/definitions/Address"
            },
            {
              "type": "null"
            }
          ],
          "description": "Address of the entry this one stands for (typically the process that owns it). While set, the entry's status mirrors that entry's, and user signals, input and resizes are routed to its address. Explicit null disables the mirroring."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "zone": {
          "anyOf": [
            {
              "$ref": "#/definitions/ZoneDescriptor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which zone to put the element in."
        },
        "type": {
          "type": "string",
          "const": "prompt_configure",
          "description": "Type of the message."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        }
      },
      "required": [
        "from",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "PromptBindings": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/definitions/PromptBinding"
          }
        ]
      }
    },
    "PromptBinding": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "freeze": {
          "type": "boolean"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "PromptHighlightMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "prompt_highlight",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "text": {
          "type": "string",
          "description": "The prompt text the highlight was computed for."
        },
        "ranges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/HighlightRange"
          },
          "description": "Syntax-highlight spans over `text`."
        },
        "filigrane": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ghost text: the most recent history entry extending `text`, offered as a completion suffix; null when there is nothing to suggest."
        }
      },
      "required": [
        "filigrane",
        "from",
        "ranges",
        "text",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "SyncMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sync",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "nonce": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "nonce",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "TextMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "stream": {
          "type": "string",
          "enum": [
            "stdout",
            "stderr"
          ],
          "description": "Stream on which the message was sent."
        },
        "text": {
          "type": "string",
          "description": "Text that was sent."
        }
      },
      "required": [
        "from",
        "stream",
        "text",
        "to",
        "type"
      ],
      "additionalProperties": false
    }
  }
}
