{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/IncomingDriverMessage",
  "definitions": {
    "IncomingDriverMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/CellConfigureMessage"
        },
        {
          "$ref": "#/definitions/CellCreateMessage"
        }
      ],
      "description": "Union of every message type."
    },
    "CellConfigureMessage": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "The cell/tab label."
        },
        "sticky": {
          "type": "boolean",
          "description": "Toggle whether the cell persists after its process closes."
        },
        "background": {
          "type": "boolean",
          "description": "If true, unfocus the cell and return focus to its zone."
        },
        "type": {
          "type": "string",
          "const": "cell_configure",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        }
      },
      "required": [
        "from",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "Address": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "To": {
      "$ref": "#/definitions/Address"
    },
    "CellCreateMessage": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ],
          "description": "The cell/tab label."
        },
        "sticky": {
          "type": "boolean",
          "description": "Toggle whether the cell persists after its process closes."
        },
        "background": {
          "type": "boolean",
          "description": "If true, unfocus the cell and return focus to its zone."
        },
        "type": {
          "type": "string",
          "const": "cell_create",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "mode": {
          "type": "string",
          "description": "Which cell handler to instantiate. Unknown modes are ignored with an error."
        },
        "prompt_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Associates the cell with an existing prompt."
        },
        "zone": {
          "anyOf": [
            {
              "$ref": "#/definitions/ZoneDescriptor"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which zone to put the cell in."
        }
      },
      "required": [
        "from",
        "mode",
        "to",
        "type"
      ],
      "additionalProperties": false
    },
    "ZoneDescriptor": {
      "type": "string"
    }
  }
}
