{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/OutgoingDriverMessage",
  "definitions": {
    "OutgoingDriverMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/ParseRequest"
        },
        {
          "$ref": "#/definitions/CommandRequest"
        },
        {
          "$ref": "#/definitions/SignalRequest"
        },
        {
          "$ref": "#/definitions/SpawnRequest"
        },
        {
          "$ref": "#/definitions/TextRequest"
        },
        {
          "$ref": "#/definitions/DataRequest"
        },
        {
          "$ref": "#/definitions/ResizeRequest"
        },
        {
          "$ref": "#/definitions/SyncRequest"
        }
      ],
      "description": "Union of every message type."
    },
    "ParseRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "parse"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "text": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/definitions/Selection",
          "description": "The prompt's selection when the parse was requested (`start === end` is the plain cursor position)."
        },
        "request_id": {
          "type": "string",
          "description": "Reference number for this parse. Whatever answers it — the highlight echo (a `prompt_configure` carrying `request_id`) — repeats it, so the machine can drop answers to superseded inputs (the user typed on in the meantime)."
        }
      },
      "required": ["from", "request_id", "selection", "text", "to", "type"],
      "additionalProperties": false
    },
    "Address": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "Selection": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number",
          "description": "Inclusive starting position of the selection"
        },
        "end": {
          "type": "number",
          "description": "Exclusive ending position of the selection"
        }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "CommandRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "text": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/definitions/Selection",
          "description": "The prompt's selection when the command fired."
        },
        "command": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "description": "Identifies this command. A driver that produces an echo in response repeats it as the echo's `id`, so the terminal can relate the two (e.g. to focus the new cell)."
        },
        "zone": {
          "type": "string",
          "description": "Where what the command shows goes (a zone, as in `@zone cmd`), when the terminal decided it (e.g. a slot the user picked it for)."
        }
      },
      "required": ["command", "from", "selection", "text", "to", "type"],
      "additionalProperties": false
    },
    "SignalRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "signal"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "code": {
          "type": "number"
        }
      },
      "required": ["code", "from", "to", "type"],
      "additionalProperties": false
    },
    "SpawnRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "spawn"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "command": {
          "type": "string"
        }
      },
      "required": ["command", "from", "to", "type"],
      "additionalProperties": false,
      "description": "Start another driver (a shell), at the address `to` (one segment, e.g. `[\"$d1\"]`): its messages come with their addresses under it, and messages to addresses under it go to it. For the host running the drivers, not for a driver: it starts `command`, in the terminal's working directory."
    },
    "TextRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "stream": {
          "type": "string",
          "const": "stdin",
          "description": "Stream the text is delivered on (keyboard input from the interface)."
        },
        "text": {
          "type": "string",
          "description": "Raw input text, as produced by the terminal emulator."
        }
      },
      "required": ["from", "stream", "text", "to", "type"],
      "additionalProperties": false
    },
    "DataRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "data"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "data": {
          "$ref": "#/definitions/Json",
          "description": "Arbitrary JSON relayed from the interface (a GUI cell message, a `proc://` request, an exec response, ...)."
        }
      },
      "required": ["data", "from", "to", "type"],
      "additionalProperties": false
    },
    "Json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Json"
          }
        }
      ]
    },
    "ResizeRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resize"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "pixel": {
          "type": "object",
          "properties": {
            "height": {
              "type": "number"
            },
            "width": {
              "type": "number"
            }
          },
          "required": ["height", "width"],
          "additionalProperties": false,
          "description": "The cell's content area, in CSS pixels."
        },
        "pty": {
          "type": "object",
          "properties": {
            "height": {
              "type": "number"
            },
            "width": {
              "type": "number"
            }
          },
          "required": ["height", "width"],
          "additionalProperties": false,
          "description": "The terminal grid, in character cells, when the cell holds a pty."
        }
      },
      "required": ["from", "pixel", "to", "type"],
      "additionalProperties": false
    },
    "SyncRequest": {
      "$ref": "#/definitions/SyncMessage"
    },
    "SyncMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sync",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "nonce": {
          "type": "string"
        }
      },
      "required": ["from", "nonce", "to", "type"],
      "additionalProperties": false
    },
    "To": {
      "$ref": "#/definitions/Address"
    }
  }
}
