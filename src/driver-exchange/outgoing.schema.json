{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/OutgoingDriverMessage",
  "definitions": {
    "OutgoingDriverMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/ParseRequest"
        },
        {
          "$ref": "#/definitions/CommandRequest"
        },
        {
          "$ref": "#/definitions/SignalRequest"
        },
        {
          "$ref": "#/definitions/TextRequest"
        },
        {
          "$ref": "#/definitions/ResizeRequest"
        },
        {
          "$ref": "#/definitions/SyncRequest"
        }
      ],
      "description": "Union of every message type."
    },
    "ParseRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "parse"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "text": {
          "type": "string"
        },
        "position": {
          "type": "number"
        }
      },
      "required": ["from", "position", "text", "to", "type"],
      "additionalProperties": false
    },
    "Address": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "CommandRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "text": {
          "type": "string"
        },
        "position": {
          "type": "number"
        },
        "command": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "description": "Identifies this command. A driver that produces an echo in response repeats it as the echo's `id`, so the terminal can relate the two (e.g. to focus the new cell)."
        }
      },
      "required": ["command", "from", "position", "text", "to", "type"],
      "additionalProperties": false
    },
    "SignalRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "signal"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "code": {
          "type": "number"
        }
      },
      "required": ["code", "from", "to", "type"],
      "additionalProperties": false
    },
    "TextRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "text"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "stream": {
          "type": "string",
          "const": "stdin",
          "description": "Stream the text is delivered on (keyboard input from the interface)."
        },
        "text": {
          "type": "string",
          "description": "Raw input text, as produced by the terminal emulator."
        }
      },
      "required": ["from", "stream", "text", "to", "type"],
      "additionalProperties": false
    },
    "ResizeRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resize"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "pixel": {
          "type": "object",
          "properties": {
            "height": {
              "type": "number"
            },
            "width": {
              "type": "number"
            }
          },
          "required": ["height", "width"],
          "additionalProperties": false,
          "description": "The cell's content area, in CSS pixels."
        },
        "pty": {
          "type": "object",
          "properties": {
            "height": {
              "type": "number"
            },
            "width": {
              "type": "number"
            }
          },
          "required": ["height", "width"],
          "additionalProperties": false,
          "description": "The terminal grid, in character cells, when the cell holds a pty."
        }
      },
      "required": ["from", "pixel", "to", "type"],
      "additionalProperties": false
    },
    "SyncRequest": {
      "$ref": "#/definitions/SyncMessage"
    },
    "SyncMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sync",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "nonce": {
          "type": "string"
        }
      },
      "required": ["from", "nonce", "to", "type"],
      "additionalProperties": false
    },
    "To": {
      "$ref": "#/definitions/Address"
    }
  }
}
