{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/OutgoingDriverMessage",
  "definitions": {
    "OutgoingDriverMessage": {
      "anyOf": [
        {
          "$ref": "#/definitions/ParseRequest"
        },
        {
          "$ref": "#/definitions/CommandRequest"
        },
        {
          "$ref": "#/definitions/SignalRequest"
        },
        {
          "$ref": "#/definitions/SyncRequest"
        }
      ],
      "description": "Union of every message type."
    },
    "ParseRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "parse"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "text": {
          "type": "string"
        },
        "position": {
          "type": "number"
        }
      },
      "required": ["from", "position", "text", "to", "type"],
      "additionalProperties": false
    },
    "Address": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "CommandRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "command"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "text": {
          "type": "string"
        },
        "position": {
          "type": "number"
        },
        "command": {
          "type": "string"
        }
      },
      "required": ["command", "from", "position", "text", "to", "type"],
      "additionalProperties": false
    },
    "SignalRequest": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "signal"
        },
        "from": {
          "$ref": "#/definitions/Address"
        },
        "to": {
          "$ref": "#/definitions/Address"
        },
        "code": {
          "type": "number"
        }
      },
      "required": ["code", "from", "to", "type"],
      "additionalProperties": false
    },
    "SyncRequest": {
      "$ref": "#/definitions/SyncMessage"
    },
    "SyncMessage": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "sync",
          "description": "Type of the message."
        },
        "from": {
          "$ref": "#/definitions/Address",
          "description": "Address of the issuing process."
        },
        "to": {
          "$ref": "#/definitions/To",
          "description": "Target of the message."
        },
        "nonce": {
          "type": "string"
        }
      },
      "required": ["from", "nonce", "to", "type"],
      "additionalProperties": false
    },
    "To": {
      "$ref": "#/definitions/Address"
    }
  }
}
