{"type": "configure", "kind": "prompt", "from": ["$proc", "cq"], "to": ["$term"], "label": "cq"}
{"type": "configure", "from": ["$proc", "cq", "2"], "to": ["$term"], "zone": "@r", "label": "app"}
{"type": "send", "from": ["$proc", "cq", "2", "$frame"], "to": ["$term"], "message": {"type": "data", "data": {"x": 1}}}
{"type": "send", "from": ["$proc", "cq", "2", "$stdout"], "to": ["$term"], "message": {"type": "text", "stream": "stdout", "text": "late output\r\n"}}
