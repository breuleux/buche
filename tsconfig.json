{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["esnext", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "myjsx",
    "paths": {
      "myjsx/jsx-runtime": ["./src/jsx/jsx-runtime.ts"]
    }
  },
  "include": ["src", "scripts", "tests", "*.ts"]
}
